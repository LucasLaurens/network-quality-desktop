{
  "name": "network-quality-desktop",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "app:install": "node scripts/install-app.mjs",
    "release": "node scripts/merge-release.mjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src tests scripts vite.config.ts playwright.config.ts eslint.config.js --max-warnings 0 && node scripts/check-method-names.mjs",
    "lint:back": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --write . && cargo fmt --all",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --check .",
    "test": "pnpm test:front && pnpm test:back",
    "test:front": "vitest run",
    "test:back": "cargo nextest run --workspace && cargo test --workspace --doc",
    "test:smoke": "cargo test -p infrastructure --test smoke -- --ignored",
    "test:visual": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "coverage:back": "node scripts/coverage-back.mjs",
    "deps:audit": "cargo deny check advisories licenses && pnpm audit",
    "mutants:domain": "cargo mutants -p domain",
    "bindings:check": "cargo test -p app --lib exports_ && git diff --exit-code -- src/bindings.ts tests/fakes/interface-texts.json",
    "tauri": "tauri",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:front && pnpm build:web && pnpm lint:back && pnpm test:back && pnpm bindings:check",
    "prepare": "lefthook install",
    "lint:all": "pnpm lint && pnpm lint:back"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.3",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
